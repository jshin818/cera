{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cera",
  "version": "0.1.0",
  "identifier": "app.cera.vault",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
